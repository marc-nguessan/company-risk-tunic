# Companies House free API key — https://developer.company-information.service.gov.uk/
CH_API_KEY=your_ch_api_key_here

# OpenRouter key (prefix sk-or-v1-) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter model slug — must support structured outputs (json_schema response_format)
LLM_MODEL=anthropic/claude-sonnet-4-5
